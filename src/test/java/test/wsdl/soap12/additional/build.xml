Copyright:
Copyright (c) 2002-2003 Apache Software Foundation.
</description>
==================================================================== -->

<project name="Round4" default="compile">
    <property name="componentName" value="test/wsdl/soap12/additional" />
    &properties;
    &paths;
    &taskdefs;
    &taskdefs_post_compile;
    &targets;
    <target name="clean">
        <echo message="Removing ${build.dir}/classes/${componentName} and ${build.dir}/work/${componentName}" />
        <delete dir="${build.dir}/classes/${componentName}"/>
        <delete dir="${build.dir}/work/${componentName}"/>
    </target>

    <target name="compile" depends="setenv">
        <property name="testname" value="additional"/>

        <!-- generate skeletons -->
        <wsdl2java url="${axis.home}/src/test/java/test/wsdl/soap12/additional/soap12-add-test.wsdl"
            output="${build.dir}/work" skeletonDeploy="no" testCase="yes" timeout="-1"
            serverSide="yes">
            <mapping namespace="http://whitemesa.net/wsdl/soap12-test" package="test.wsdl.soap12.additional"/>
            <mapping namespace="http://example.org/ts-tests/xsd" package="test.wsdl.soap12.additional.xsd"/>
        </wsdl2java>

        <mkdir dir="${build.dest}"/>

        <copy todir="${build.dir}/work/test/wsdl/soap12/additional" overwrite="yes">
          <fileset dir="${axis.home}/src/test/java/test/wsdl/soap12/additional">
            <include name="*TestCase.java"/>
            <include name="*Service.java"/>
          </fileset>
        </copy>

        <!-- compile the code -->
        <javac srcdir="${build.dir}/work/test/wsdl/soap12/additional" destdir="${build.dest}" debug="${debug}" nowarn="${nowarn}" source="${source}" fork="${javac.fork}" verbose="true">
            <classpath>
                <path refid="classpath"/>
            </classpath>
            <include name="**/*.java"/>
        </javac>
    </target>

    <target name="run" depends="compile">
        <antcall target="execute-Component" />
    </target>

</project>
