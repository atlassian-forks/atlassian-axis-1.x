</description>
==================================================================== -->

<project default="compile">

<property name="componentName" value="test/wsdl/doclit_arrays" />
        &properties;
        &paths;
        &taskdefs;
        &taskdefs_post_compile;
        &targets;

<target name="clean">
    <echo message="Removing ${build.dir}/classes/${componentName} and ${build.dir}/work/${componentName}" />
    <delete dir="${build.dir}/classes/${componentName}"/>
    <delete dir="${build.dir}/work/${componentName}"/>
</target>

<target name="copy" depends="setenv"/>

<target name="compile" depends="copy">
  <echo message="Compiling test.wsdl.doclit_arrays"/>
    
    <!-- Compile the test classes for Java2WSDL -->
    <javac srcdir="${axis.home}/src/test/java" destdir="${build.dest}" nowarn="${nowarn}" source="${source}" fork="${javac.fork}"
           debug="${debug}">
      <classpath refid="classpath" />
      <include name="test/wsdl/doclit_arrays/*.java" />
    </javac>

    <!-- Create output directory for WSDL -->
    <mkdir dir="${build.dir}/work/test/wsdl/doclit_arrays"/>

    <!-- Generate WSDL from java -->
    <java2wsdl output="${build.dir}/work/test/wsdl/doclit_arrays/ArrayService.wsdl"
               className="test.wsdl.doclit_arrays.ArrayService"
               namespace="http://doclit_arrays.wsdl.test/"
               location="http://localhost:8080/axis/services/DocArrays"
               style="DOCUMENT">
        <mapping package="test.wsdl.doclit_arrays" namespace="http://doclit_arrays.wsdl.test/" />
    </java2wsdl>

    <!-- Generate client stubs from the generated WSDL -->
    <wsdl2java url="${build.dir}/work/test/wsdl/doclit_arrays/ArrayService.wsdl"
               output="${build.dir}/work"
               serverSide="no"
               testcase="yes">
    </wsdl2java>

    <!-- Copy any additional test files -->
    <copy todir="${build.dir}/work/test/wsdl/doclit_arrays" overwrite="yes">
      <fileset dir="${axis.home}/src/test/java/test/wsdl/doclit_arrays">
        <include name="*TestCase.java"/>
      </fileset>
    </copy>

    <!-- Compile all generated and test files -->
    <javac srcdir="${build.dir}/work" destdir="${build.dest}" nowarn="${nowarn}" source="${source}" fork="${javac.fork}"
           debug="${debug}">
      <classpath refid="classpath" />
      <include name="test/wsdl/doclit_arrays/*.java" />
    </javac>

</target>

<target name="run" depends="compile">
  <!-- Run JUnit tests directly without server deployment -->
  <junit printsummary="yes" haltonerror="yes" haltonfailure="yes">
    <classpath refid="classpath" />
    <formatter type="plain" />
    <test name="test.wsdl.doclit_arrays.ArrayServiceTestCase" />
  </junit>
</target>

</project>