/**
 * Mock stock quote service for testing.
 */
public class DelayedQuote {

    public String getQuote(String symbol) throws Exception {
        float value;
        if ("SUNW".equals(symbol)) value = 3.67f;
        else if ("IBM".equals(symbol)) value = 145.32f;
        else if ("MSFT".equals(symbol)) value = 320.15f;
        else if ("AAPL".equals(symbol)) value = 175.43f;
        else if ("GOOG".equals(symbol)) value = 2850.75f;
        else if ("XXX".equals(symbol)) value = 55.25f;
        else value = 0.00f;
        return String.valueOf(value);
    }
}
